#!/bin/bash -e

# If running the rails server then create or migrate existing database,
# sync the mobile suit master from db/data/units.json, and announce new releases (all idempotent)
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare mobile_suits:sync release_notes:announce
fi

exec "${@}"
