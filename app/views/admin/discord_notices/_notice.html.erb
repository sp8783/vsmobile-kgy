<%= form_with model: notice, scope: :discord_notice, url: admin_discord_notice_path(notice.kind), method: :patch,
      class: "ui-card dn-card",
      data: {
        controller: "discord-notice",
        discord_notice_event_name_value: preview.name,
        discord_notice_held_on_value: preview.held_on.iso8601,
        discord_notice_thread_url_value: preview.discord_thread_url.to_s
      } do |f| %>
  <div class="dn-card-head">
    <div class="flex min-w-0 flex-col gap-1">
      <h2 class="text-lg font-black text-ink"><%= notice.label %></h2>
      <p class="text-sm font-bold text-muted">投稿先: <%= notice.preparation? ? "イベントフォーラム（イベントの記事）" : "イベントリマインド" %></p>
    </div>
    <label class="dn-switch">
      <%= f.check_box :enabled, class: "sr-only", data: { discord_notice_target: "enabled", action: "discord-notice#refresh" } %>
      <span class="dn-switch-knob" aria-hidden="true"></span>
      <span data-discord-notice-target="enabledLabel">送る</span>
    </label>
  </div>

  <% if notice.errors.any? %>
    <div class="mx-[22px] mt-4 rounded-lg bg-neg/10 px-4 py-3">
      <% notice.errors.full_messages.each do |message| %>
        <p class="dn-warn"><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="dn-card-body">
    <div class="dn-fields" data-discord-notice-target="fields">
      <div class="flex flex-col gap-2">
        <p class="dn-caption">送るタイミング</p>
        <div class="flex flex-col gap-2" data-discord-notice-target="timings">
          <% notice.timing_list.each do |timing| %>
            <%= render "timing", timing: timing, removable: !notice.preparation? %>
          <% end %>
        </div>
        <% unless notice.preparation? %>
          <p class="dn-note" data-discord-notice-target="emptyTimings" hidden>送るタイミングがありません。追加すると、そのタイミングでリマインドを送ります。</p>
          <p class="dn-warn" data-discord-notice-target="duplicate" hidden>同じ日数のタイミングが2つあります。日数を変えるか消してください。</p>
          <button type="button" class="dn-add" data-action="discord-notice#addTiming">＋ タイミングを追加</button>
          <template data-discord-notice-target="timingTemplate">
            <%= render "timing", timing: DiscordNotice::Timing.new(days_before: 3, hour: 8), removable: true %>
          </template>
        <% end %>
      </div>

      <div>
        <%= f.label :body, "文面", class: "ui-label", for: "discord_notice_#{notice.kind}_body" %>
        <%= f.text_area :body, id: "discord_notice_#{notice.kind}_body", rows: notice.preparation? ? 10 : 7, class: "ui-form-control leading-relaxed",
              data: { discord_notice_target: "body", action: "input->discord-notice#refresh" } %>
        <div class="mt-2 flex flex-wrap items-center gap-1.5">
          <span class="dn-caption">差し込む:</span>
          <% DiscordNotice::PLACEHOLDERS.each do |token| %>
            <button type="button" class="dn-chip" data-token="<%= token %>" data-action="discord-notice#insert"><%= token %></button>
          <% end %>
        </div>
      </div>
    </div>

    <div class="dn-preview-col">
      <p class="dn-caption">プレビュー（<%= preview.name %>・<%= DiscordNotice.format_date(preview.held_on) %> 開催<%= "。開催予定のイベントがないため、例の値で表示しています" unless preview.persisted? %>）</p>
      <% unless notice.preparation? %>
        <div class="flex flex-wrap gap-1.5" data-discord-notice-target="previewTabs"></div>
      <% end %>
      <div class="dn-discord">
        <div class="dn-discord-channel"><%= notice.preparation? ? "フォーラム › #{preview.name}の記事" : "# イベントリマインド" %></div>
        <div class="flex gap-3" data-discord-notice-target="previewMessage">
          <div class="dn-discord-avatar" aria-hidden="true">VS</div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline gap-1.5">
              <span class="dn-discord-name">VS.モバイル</span>
              <span class="dn-discord-badge">アプリ</span>
              <span class="dn-discord-time" data-discord-notice-target="sendAt"></span>
            </div>
            <div class="dn-lines" data-discord-notice-target="previewLines"></div>
          </div>
        </div>
        <p class="dn-discord-empty" data-discord-notice-target="previewEmpty" hidden></p>
      </div>
      <% if notice.preparation? %>
        <p class="dn-note">フォーラムの記事が登録されていないイベントには送りません。リマインドと同じ日時のときは、リマインドより先に送ります。</p>
      <% end %>
    </div>
  </div>

  <div class="dn-card-foot">
    <p class="text-sm font-bold text-muted" data-discord-notice-target="schedule"></p>
    <%= f.submit "保存する", class: "ui-btn ui-btn-primary cursor-pointer" %>
  </div>
<% end %>
