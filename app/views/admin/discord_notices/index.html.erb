<%
  # プレビューに使うイベント。開催予定のイベントがなければ例の値を使う
  preview = @preview_event || Event.new(name: "イベント名", held_on: Date.current + 7, discord_thread_url: "https://discord.com/channels/0/0")
%>
<div class="ui-page">
  <%= render "admin/shared/discord_header", current: :notices, description: "イベントのリマインドと事前準備のお願いの文面・送るタイミングを設定します。投稿先の Webhook は「投稿先」で設定します。" %>

  <div class="grid gap-4">
    <%= render Ui::CardComponent.new(title: "差し込み用の文字", padded: true) do %>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <% [
          [ "{イベント名}", "イベント名", preview.name ],
          [ "{開催日}", "開催日", DiscordNotice.format_date(preview.held_on) ],
          [ "{いつ}", "送るタイミングから決まる言い方", "明日・1週間後・3日後" ],
          [ "{フォーラムURL}", "イベントのフォーラム記事のリンク", "#記事名 で表示" ]
        ].each do |token, description, example| %>
          <div class="flex min-w-0 flex-col gap-1 rounded-lg bg-bg px-3 py-2.5">
            <code class="dn-token"><%= token %></code>
            <span class="text-sm font-bold text-ink"><%= description %></span>
            <span class="text-xs font-bold text-muted">例: <%= example %></span>
          </div>
        <% end %>
      </div>
      <div class="mt-3 grid gap-1">
        <p class="dn-note">差し込む値が空の行は送りません（フォーラムの記事が未登録のイベントでは、{フォーラムURL} の行が消えます）。</p>
        <p class="dn-note">文面には Discord の書式（**太字**、# 見出し、&gt; 引用、[文字](URL) など）が使え、プレビューにも反映されます。Discord のチャンネル・記事へのリンクは、Discord では名前で表示されます（プレビューでは名前を取得できないため「# チャンネル名」と表示します）。</p>
      </div>
    <% end %>

    <% @notices.each do |notice| %>
      <%= render "notice", notice: notice, preview: preview %>
    <% end %>
  </div>
</div>
